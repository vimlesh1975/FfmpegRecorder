<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FfmpegRecorder</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="DeckLinkAPI.Interop">
      <HintPath>DeckLinkSdk\DeckLinkAPI.Interop.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

  <Target Name="CreateTimestampedExecutableCopy" AfterTargets="Build" Condition="Exists('$(TargetDir)$(AssemblyName).exe')">
    <PropertyGroup>
      <ExecutableSourcePath>$(TargetDir)$(AssemblyName).exe</ExecutableSourcePath>
      <TimestampedExecutableBaseName>4Ch_Recoder_1Ch_Player</TimestampedExecutableBaseName>
      <TimestampedExecutablePath>$(TargetDir)$(TimestampedExecutableBaseName)_$([System.DateTime]::Now.ToString('ddMMyy_HHmmss')).exe</TimestampedExecutablePath>
    </PropertyGroup>

    <ItemGroup>
      <ExistingTimestampedExecutables Include="$(TargetDir)$(AssemblyName)_*.exe" />
      <ExistingTimestampedExecutables Include="$(TargetDir)$(TimestampedExecutableBaseName)_*.exe" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)decklinkplayer*.exe" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)decklinkplayer.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)decklinkplayer.pdb" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)decklinkplayer.deps.json" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)decklinkplayer.runtimeconfig.json" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)DeckLinkOutputHelper.exe" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)FFmpeg.AutoGen.*.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)MediaInfo.Wrapper.Core.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)Microsoft.Extensions.Logging.Abstractions.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)brotli*.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)libcrypto-3-x64.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)libcurl.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)libmediainfo.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)libssh2.dll" />
      <DeckLinkPlayerHelperArtifacts Include="$(TargetDir)libssl-3-x64.dll" />
    </ItemGroup>

    <Delete Files="@(ExistingTimestampedExecutables)" />
    <Delete Files="@(DeckLinkPlayerHelperArtifacts)" />
    <Move SourceFiles="$(ExecutableSourcePath)" DestinationFiles="$(TimestampedExecutablePath)" />
    <Message Importance="High" Text="Created timestamped executable: $(TimestampedExecutablePath)" />
  </Target>

</Project>
